# Environment configuration for SenimAI Backend
PROJECT_NAME="SenimAI - AI Trust Fact-Checking API"
DEBUG=false

# If true, runs in offline/mock demo mode (great for presentation stability or offline dev)
MOCK_MODE=false

# LLM Provider Configuration
# Works with OpenAI, OpenRouter, Groq, DeepSeek, or any OpenAI-compatible API
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Google Gemini API (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Search API Provider: "tavily", "serper", or "duckduckgo" (duckduckgo requires no key)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Concurrency & Limits
MAX_CLAIMS=8
MAX_CONCURRENT_CLAIMS=4
SEARCH_RESULTS_PER_CLAIM=4
REQUEST_TIMEOUT_SECONDS=30
